# Endereço do backend NestJS (sem /api; /api é a rota do Swagger).
VITE_API_URL=http://localhost:3000

# Slug/subdomínio da distribuidora já cadastrada no Bebfy.
# Obrigatório para o login pelo frontend local ou domínio central.
VITE_TENANT_SLUG=sua-loja

# Opcional para SaaS em subdomínios loja.bebfy.com.br. Deixe vazio no desenvolvimento.
# VITE_TENANT_BASE_DOMAIN=bebfy.com.br
