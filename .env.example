# URL pública da API NestJS (sem /api; /api é Swagger).
VITE_API_URL=http://localhost:3000

# Multi-lojas no mesmo domínio:
# https://bebfy.com.br/bebfybdteste -> login da empresa
# https://bebfy.com.br/SaaS/admin -> login de administradores da plataforma
# Não configure VITE_TENANT_SLUG: a loja vem do primeiro segmento da URL.

# Opcional apenas para instalações legadas em loja.bebfy.com.br:
# VITE_TENANT_BASE_DOMAIN=bebfy.com.br
